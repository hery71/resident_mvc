<script>
// Use explicit paper dimensions so Legal uses its full printable width.
function applyPrintStyle(paper, orientation) {
    const landscape = orientation === 'landscape';
    const longEdge = paper === 'legal' ? 355.6 : 279.4;
    const width = landscape ? longEdge : 215.9;
    const height = landscape ? 215.9 : longEdge;
    document.getElementById('orientation-style').textContent =
        '@page { size: ' + width + 'mm ' + height + 'mm; margin: 10mm; }';
    document.documentElement.style.setProperty('--menu-paper-width', (width - 20) + 'mm');
}
(function () {
    const params = new URLSearchParams(window.location.search);
    const settings = [
        ['printSeason', 'season', '.toggle-col-season-week', false],
        ['printBreakfast', 'breakfast', '.toggle-col-breakfast', true],
        ['printDesserts', 'desserts', '.toggle-col-desserts', true],
        ['printSecond', 'second', '.second-choice-row', false]
    ];
    settings.forEach(([id, key, selector, defaultValue]) => {
        const input = document.getElementById(id);
        input.checked = params.has(key) ? params.get(key) === '1' : defaultValue;
        function update() {
            document.querySelectorAll(selector).forEach(element => {
                element.classList.toggle('hidden-col', !input.checked);
            });
        }
        input.addEventListener('change', update);
        update();
    });
    const font = document.querySelector('select[onchange*="setPrintFontSize"]');
    // Use the same font size in the preview and the printed document.
    setPrintFontSize(font.value);
})();
</script>
